# Use the app_backend database role created by migration 002.
DATABASE_URL=postgresql://app_backend:YOUR_PASSWORD@YOUR_DATABASE_HOST:5432/postgres?sslmode=require
APP_SECRET=replace-with-a-long-random-secret-before-production
NODE_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Local mode is explicitly selected for offline development.
# For a hosted model, select openai or anthropic and supply the matching key/model.
AI_PROVIDER=local
AI_MODEL_NAME=gpt-4o-mini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
